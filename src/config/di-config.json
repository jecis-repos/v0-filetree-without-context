{
  "services": [
    {
      "name": "ICacheService",
      "implementation": "CacheService",
      "lifetime": "singleton",
      "dependencies": [],
      "configuration": {
        "maxSize": 1000,
        "defaultTtl": 300000,
        "evictionStrategy": "LRU"
      }
    },
    {
      "name": "IPerformanceMonitor",
      "implementation": "PerformanceMonitor",
      "lifetime": "singleton",
      "dependencies": [],
      "configuration": {
        "maxMetrics": 1000
      }
    },
    {
      "name": "IFileSystemCalculator",
      "implementation": "FileSystemCalculator",
      "lifetime": "singleton",
      "dependencies": ["ICacheService"]
    },
    {
      "name": "IFileSystemProvider",
      "implementation": "WasmFileSystemProvider",
      "lifetime": "singleton",
      "dependencies": ["IPerformanceMonitor"],
      "configuration": {
        "wasmPath": "/wasm/filesystem.wasm"
      }
    }
  ]
}
